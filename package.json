{
  "name": "orbfall",
  "version": "1.0.0",
  "private": true,
  "description": "Orbfall – roguelite peg-drop mobile game",
  "scripts": {
    "start": "npx http-server www -p 8080 -c-1",
    "android:add": "npx cap add android",
    "sync": "npx cap sync",
    "android:open": "npx cap open android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor-community/admob": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
